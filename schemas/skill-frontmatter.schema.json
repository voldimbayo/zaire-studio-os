{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZaireStudioSkillFrontmatter",
  "description": "Schéma officiel du frontmatter YAML pour les 57 Agent Skills de ZAÏRE STUDIO OS (compatible Anthropic Agent Skills & Claude.ai).",
  "type": "object",
  "required": [
    "name",
    "description",
    "metadata"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "Identifiant kebab-case unique du skill (ex: dir-01-studio-orchestrator)."
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1024,
      "description": "Description précise du rôle, des déclencheurs d'activation et des livrables produits."
    },
    "license": {
      "type": "string",
      "default": "Proprietary - ZAÏRE STUDIO OS"
    },
    "compatibility": {
      "type": "string",
      "description": "Environnements compatibles (Claude.ai, Claude Code, Antigravity)."
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "department",
        "stratum",
        "version",
        "inputs",
        "outputs",
        "upstream_dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(DIR|NAR|WLD|GD|AI|ART|AUD|ENG|PRD)-[0-9]{2}$"
        },
        "department": {
          "type": "string",
          "enum": [
            "00-direction",
            "01-narrative",
            "02-world-design",
            "03-game-design",
            "04-ai-simulation",
            "05-art-animation",
            "06-audio-localization",
            "07-engineering",
            "08-production-quality"
          ]
        },
        "stratum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "upstream_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(DIR|NAR|WLD|GD|AI|ART|AUD|ENG|PRD)-[0-9]{2}$"
          }
        }
      }
    }
  }
}
