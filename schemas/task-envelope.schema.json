{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZaireTaskEnvelope",
  "description": "Schéma d'un ordre de mission typé émis par DIR-01 (Studio Orchestrator) vers un skill spécialisé.",
  "type": "object",
  "required": [
    "task_id",
    "target_skill",
    "objective",
    "context_entities",
    "constraints",
    "required_output_template",
    "upstream_artifacts"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TSK-[0-9]{4}-[0-9]{3,}$"
    },
    "target_skill": {
      "type": "string",
      "pattern": "^(DIR|NAR|WLD|GD|AI|ART|AUD|ENG|PRD)-[0-9]{2}$"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "context_entities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(CHR|FAM|ORG|DST|LOC|MSN|ITM|VEH|SYS)-[A-Z0-9-]+$"
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "target_frametime_ms",
        "languages"
      ],
      "properties": {
        "max_npc_active": {
          "type": "integer",
          "minimum": 0
        },
        "target_frametime_ms": {
          "type": "number",
          "enum": [16.6, 33.3]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_output_template": {
      "type": "string"
    },
    "upstream_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
